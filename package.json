{
  "name": "lumoscore-xrpl",
  "private": true,
  "version": "0.1.0",
  "description": "LumosCore on the XRP Ledger. Separate project on purpose: nothing here may read or write C:/LumosCore.",
  "scripts": {
    "build": "node _tools/extract_site.js xrpl --root",
    "serve": "node serve.js 8082",
    "test": "node _tools/xrpl-core.test.js",
    "predeploy": "node _tools/predeploy_check.js",
    "deploy": "npx wrangler pages deploy dist --project-name=lumoscore-xrpl --branch=main --commit-dirty=true"
  }
}
